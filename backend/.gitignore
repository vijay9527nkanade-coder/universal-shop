# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment files — never commit secrets
.env

# Distribution / packaging
dist/
build/
*.egg-info/

# IDE
.vscode/
.idea/

# Alembic generated (keep versions/ directory itself)
alembic/versions/*.py
!alembic/versions/.gitkeep
